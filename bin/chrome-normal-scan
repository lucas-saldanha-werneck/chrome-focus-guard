#!/usr/bin/env node
// chrome-normal-scan: lists scripts that open the main Chrome (not Beta), for scripts run outside Claude
// (launchd, cron) where the hook does not reach. Prints file:line: reason. Light: grep prefilter with a
// timeout, no walk of the home folder.
//
//   chrome-normal-scan                 print findings (exit 1 if any outside the allow list)
//   chrome-normal-scan --record        also remember current findings as seen
//   chrome-normal-scan --notify CMD    run `CMD "<text>"` (one argument) for findings not seen before, then remember them
//
// Config (outside the repo): ~/.config/chrome-focus-guard/roots.txt (folders to scan, one per line; `*` ok
// at the end, e.g. ~/.local/share/*) and allow.txt (path prefixes that are exceptions).
// LaunchAgents: ProgramArguments of loaded agents whose label starts with CHROME_SCAN_LABEL_PREFIX (default: all
// user agents in ~/Library/LaunchAgents).
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const { codeNormalChrome, bashNormalChrome, isCodeFile, loadAllow, isAllowed } = await import(path.join(here, '..', 'lib', 'detect.mjs'));

const HOME = os.homedir();
const CONF = process.env.CHROME_SCAN_CONFIG_DIR || path.join(HOME, '.config', 'chrome-focus-guard');
const STATE = process.env.CHROME_SCAN_STATE_DIR || path.join(HOME, '.local', 'state', 'chrome-focus-guard');
const LABEL = process.env.CHROME_SCAN_LABEL_PREFIX || '';
const args = process.argv.slice(2);
const notifyCmd = args.includes('--notify') ? args[args.indexOf('--notify') + 1] : null;
const record = args.includes('--record') || !!notifyCmd;
const t0 = Date.now();

const exp = p => (p.startsWith('~/') ? path.join(HOME, p.slice(2)) : p);
function readLines(f) {
  try { return fs.readFileSync(f, 'utf8').split('\n').map(l => l.replace(/#.*/, '').trim()).filter(Boolean); } catch (_) { return null; }
}
function roots() {
  const list = readLines(path.join(CONF, 'roots.txt')) || ['~/.local/share/*', '~/.local/bin'];
  const out = [];
  for (const r of list.map(exp)) {
    if (r.endsWith('/*')) {
      const d = r.slice(0, -2);
      try { for (const n of fs.readdirSync(d)) { const p = path.join(d, n); try { if (fs.statSync(p).isDirectory()) out.push(p); } catch (_) {} } } catch (_) {}
    } else if (fs.existsSync(r)) out.push(r);
  }
  return out;
}

const EXCL = ['node_modules', '.git', '*venv*', 'site-packages', '__pycache__', 'dist', 'build', '.cache', 'cache', 'Cache',
  'uv', 'venvs', 'browser-profile*', '*profile*', 'Profiles', 'logs', 'tmp', 'man', 'powershell', 'backup*', '*-backup*', 'whatsapp-limpeza*', 'skilleval*'];
const PREFILTER = 'Google.Chrome|webbrowser|channel|9222|open ';
const INCLUDE = ['mjs', 'cjs', 'js', 'ts', 'py', 'sh', 'zsh', 'bash', 'applescript'].map(e => `--include=*.${e}`);

function grepFiles(dirs) {
  if (!dirs.length) return [];
  const r = spawnSync('grep', ['-rIlE', ...EXCL.map(e => `--exclude-dir=${e}`), ...INCLUDE, '-e', PREFILTER, ...dirs],
    { encoding: 'utf8', timeout: 90_000, maxBuffer: 32 * 1024 * 1024 });
  if (r.error) console.error(`aviso: grep: ${r.error.code || r.error.message}`);
  if (r.stderr && /Operation not permitted|Permission denied/.test(r.stderr)) console.error(`aviso: sem acesso a parte das pastas (${r.stderr.split('\n')[0]})`);
  return (r.stdout || '').split('\n').filter(Boolean);
}

// Files without extension (shebang scripts) in each root and its bin/ (depth 1 only: cheap).
function shebangFiles(dirs) {
  const out = [];
  for (const d of dirs) for (const sub of [d, path.join(d, 'bin')]) {
    let names = []; try { names = fs.readdirSync(sub); } catch (_) { continue; }
    for (const n of names) {
      if (n.includes('.') || n.startsWith('.')) continue;
      const p = path.join(sub, n);
      try {
        const st = fs.statSync(p); if (!st.isFile() || st.size > 2_000_000) continue;
        const fd = fs.openSync(p, 'r'); const b = Buffer.alloc(120); fs.readSync(fd, b, 0, 120, 0); fs.closeSync(fd);
        if (b.toString('utf8').startsWith('#!')) out.push(p);
      } catch (_) {}
    }
  }
  return out;
}

const findings = []; // {file, line, reason}
const seenFiles = new Set();
function scanFile(p) {
  if (seenFiles.has(p)) return; seenFiles.add(p);
  let txt; try { txt = fs.readFileSync(p, 'utf8'); } catch (_) { return; }
  if (!isCodeFile(p, txt.slice(0, 200).split('\n')[0])) return;
  for (const h of codeNormalChrome(txt, p)) findings.push({ file: p, line: h.line, reason: h.reason });
}

const dirs = roots();
for (const f of grepFiles(dirs)) scanFile(f);
for (const f of shebangFiles(dirs)) scanFile(f);

// LaunchAgents: loaded ones only; their command line and the script they run.
const LA = path.join(HOME, 'Library', 'LaunchAgents');
let loaded = new Set();
const ll = spawnSync('launchctl', ['list'], { encoding: 'utf8', timeout: 10_000 });
if (ll.stdout) loaded = new Set(ll.stdout.split('\n').map(l => l.split('\t')[2]).filter(Boolean));
let agents = 0;
try {
  for (const n of fs.readdirSync(LA)) {
    if (!n.endsWith('.plist') || !n.startsWith(LABEL)) continue;
    const label = n.slice(0, -6); if (!loaded.has(label)) continue;
    const r = spawnSync('plutil', ['-extract', 'ProgramArguments', 'json', '-o', '-', path.join(LA, n)], { encoding: 'utf8', timeout: 5000 });
    let pa; try { pa = JSON.parse(r.stdout); } catch (_) { continue; }
    agents++;
    const cmd = pa.join(' ');
    const why = bashNormalChrome(cmd, { chromeRunning: () => true });
    if (why) findings.push({ file: path.join(LA, n), line: 0, reason: `${why} (ProgramArguments)` });
    for (const a of pa) { const p = exp(a); if (p.startsWith('/') && !p.endsWith('.plist')) { try { if (fs.statSync(p).isFile()) scanFile(p); } catch (_) {} } }
  }
} catch (_) {}

const allow = loadAllow(path.join(CONF, 'allow.txt'));
const bad = findings.filter(f => !isAllowed(f.file, allow));
const ok = findings.filter(f => isAllowed(f.file, allow));
const rel = p => (p.startsWith(HOME) ? '~' + p.slice(HOME.length) : p);

console.log(`chrome-normal-scan: ${dirs.length} pastas, ${agents} LaunchAgents ativos, ${seenFiles.size} arquivos lidos, ${((Date.now() - t0) / 1000).toFixed(1)} s`);
if (bad.length) { console.log(`\nUsam o Chrome normal (${bad.length}):`); for (const f of bad) console.log(`${rel(f.file)}:${f.line}: ${f.reason}`); }
else console.log('\nNada fora da lista de exceções.');
if (ok.length) {
  const by = {}; for (const f of ok) by[rel(f.file)] = (by[rel(f.file)] || 0) + 1;
  console.log(`\nNa lista de exceções (${ok.length} linhas em ${Object.keys(by).length} arquivos):`);
  for (const [f, n] of Object.entries(by)) console.log(`  ${f} (${n})`);
}

if (record) {
  const sf = path.join(STATE, 'seen.txt');
  const seen = new Set(readLines(sf) || []);
  const key = f => `${f.file}\t${f.reason}`;
  const fresh = bad.filter(f => !seen.has(key(f)));
  const freshFiles = [...new Set(fresh.map(f => rel(f.file)))];
  if (notifyCmd && freshFiles.length) {
    const text = `chrome-normal-scan: ${freshFiles.length} script(s) novo(s) usam o Chrome normal: ${freshFiles.slice(0, 5).join(', ')}${freshFiles.length > 5 ? ' ...' : ''}. Rode chrome-normal-scan para ver as linhas.`;
    const r = spawnSync(notifyCmd, [text], { encoding: 'utf8', timeout: 60_000 });
    console.log(`\naviso enviado (${notifyCmd}): saída ${r.status}`);
  }
  for (const f of bad) seen.add(key(f));
  fs.mkdirSync(STATE, { recursive: true });
  fs.writeFileSync(sf, [...seen].join('\n') + '\n');
  if (notifyCmd && !freshFiles.length) console.log('\nnada novo desde a última rodada: sem aviso');
}
process.exit(bad.length ? 1 : 0);
